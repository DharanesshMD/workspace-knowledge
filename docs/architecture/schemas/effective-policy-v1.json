{
  "$defs": {
    "ProductPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_loopback": {
          "type": "boolean"
        },
        "https_origins": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "private_days": {
          "format": "uint16",
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "report_days": {
          "format": "uint16",
          "maximum": 7,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "private_days",
        "report_days",
        "allow_loopback",
        "https_origins"
      ],
      "type": "object"
    }
  },
  "$id": "urn:workspace-knowledge:effective-policy:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "can_review": {
      "type": "boolean"
    },
    "policy_revision": {
      "format": "int64",
      "type": "integer"
    },
    "product": {
      "type": "string"
    },
    "restrictions": {
      "$ref": "#/$defs/ProductPolicy"
    },
    "services": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "product",
    "services",
    "can_review",
    "policy_revision",
    "restrictions"
  ],
  "title": "Policy",
  "type": "object"
}
