<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.workspace-knowledge.agent</string>
<key>ProgramArguments</key><array>
<string>REPLACE_HOME/.local/bin/wk-agent</string><string>--state-dir</string>
<string>REPLACE_HOME/.local/share/workspace-knowledge</string><string>serve</string>
</array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>10</integer>
<key>Umask</key><integer>63</integer>
</dict></plist>
